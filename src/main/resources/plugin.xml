<pluginMetaData path="fhir-profile-mapper">
  <name>FHIR Profile Mapper</name>
  <author>kazepoy</author>
  <pluginVersion>${project.version}</pluginVersion>
  <mirthVersion>${oie.version}</mirthVersion>
  <description>Mapper graphique de profils FHIR, runtime et services de test. Transformation FML sur un modèle logique OIE. Requiert FHIR Data Type 1.5.1.</description>
  <serverClasses>
    <string>org.oie.fhir.mapper.server.FhirProfileMapperPlugin</string>
    <string>org.oie.fhir.mapper.server.FhirMapperChannelPlugin</string>
    <string>org.oie.fhir.fml.server.FmlServicePlugin</string>
    <string>org.oie.fhir.fml.server.FmlChannelPlugin</string>
  </serverClasses>
  <library type="SHARED" path="fhir-profile-mapper-server.jar" />
  <apiProvider type="SERVLET_INTERFACE" name="org.oie.fhir.mapper.FhirProfileServletInterface" />
  <apiProvider type="SERVER_CLASS" name="org.oie.fhir.mapper.server.FhirProfileServlet" />
  <apiProvider type="SERVLET_INTERFACE" name="org.oie.fhir.fml.FmlServletInterface" />
  <apiProvider type="SERVER_CLASS" name="org.oie.fhir.fml.server.FmlServlet" />
</pluginMetaData>
