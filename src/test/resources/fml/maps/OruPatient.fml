map "http://example.org/fhir/StructureMap/OruPatient" = "OruPatient"

// HL7 v2 PID of an ORU^R01 to a Patient, on the generic OIE logical model:
// a node is found by its name (PID, PID.5) or its position (component 1).

uses "http://oie.org/fhir/StructureDefinition/OieMessage" alias OieMessage as source
uses "http://hl7.org/fhir/StructureDefinition/Patient" alias Patient as target

group OruPatient(source src : OieMessage, target tgt : Patient) {
  src.node as pid where name = 'PID' then {
    pid.node as cx where name = 'PID.3' then {
      cx.node as type where position = 5 and value = 'PI' then {
        cx.node as id where position = 1 -> tgt.identifier as identifier then {
          id -> identifier.system = 'urn:oid:1.2.250.1.71.4.2.7' "ipp-system";
          id.value as v -> identifier.value = v "ipp-value";
        } "ipp";
      } "ipp-type";
    } "identifiers";
    pid.node as xpn where name = 'PID.5' -> tgt.name as name then {
      xpn.node as family where position = 1 then { family.value as v -> name.family = v "family"; } "family-name";
      xpn.node as given where position = 2 then { given.value as v -> name.given = v "given"; } "given-name";
    } "name";
    pid.node as dob where name = 'PID.7' then {
      dob.node as time where position = 1 then {
        time.value as v where v.length() >= 8 -> tgt.birthDate = (v.substring(0, 4) & '-' & v.substring(4, 2) & '-' & v.substring(6, 2)) "birthDate";
      } "birth-time";
    } "date-of-birth";
    pid.node as sex where name = 'PID.8' then {
      sex.node as code where position = 1 then {
        code.value as v -> tgt.gender = translate(v, 'http://example.org/ConceptMap/v2-sex', 'code') "gender";
      } "sex-code";
    } "sex";
  } "pid";
}
