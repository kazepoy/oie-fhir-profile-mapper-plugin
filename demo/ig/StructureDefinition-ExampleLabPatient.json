  "publisher": "Exemple oru2fhir",
  "description": "Patient d'un compte rendu de laboratoire : l'IPP (PID-3 de type PI) est obligatoire, avec son système.",
  "fhirVersion": "4.0.1",
  "kind": "resource",
  "abstract": false,
  "type": "Patient",
