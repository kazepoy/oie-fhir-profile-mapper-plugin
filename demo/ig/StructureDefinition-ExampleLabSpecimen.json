{
  "resourceType": "StructureDefinition",
  "id": "ExampleLabSpecimen",
  "url": "http://example.org/fhir/oru2fhir/StructureDefinition/ExampleLabSpecimen",
  "version": "0.1.0",
  "name": "ExampleLabSpecimen",
  "title": "Prélèvement de laboratoire",
  "status": "draft",
  "experimental": true,
  "publisher": "Exemple oru2fhir",
  "description": "Le prélèvement (SPM) : type, patient et date de prélèvement obligatoires.",
  "fhirVersion": "4.0.1",
  "kind": "resource",
  "abstract": false,
  "type": "Specimen",
  "baseDefinition": "http://hl7.org/fhir/StructureDefinition/Specimen",
  "derivation": "constraint",
  "differential": {
    "element": [
      {
        "id": "Specimen",
        "path": "Specimen"
      },
      {
        "id": "Specimen.type",
        "path": "Specimen.type",
        "min": 1,
        "mustSupport": true
      },
      {
        "id": "Specimen.subject",
        "path": "Specimen.subject",
        "min": 1,
        "mustSupport": true
      },
      {
        "id": "Specimen.collection",
        "path": "Specimen.collection",
        "min": 1
      },
      {
        "id": "Specimen.collection.collected[x]",
        "path": "Specimen.collection.collected[x]",
        "min": 1,
        "type": [
          {
            "code": "dateTime"
          }
        ],
        "mustSupport": true
      }
    ]
  }
}