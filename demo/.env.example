# Facultatif : copier en .env pour changer les valeurs de compose.yaml.
OIE_BIND_ADDRESS=127.0.0.1
OIE_HTTPS_PORT=8443
# Plage de ports publiée dans compose.yaml pour les exemples : 10800-10900.
TZ=Europe/Paris
OIE_JAVA_MAX_HEAP=2g

# Appliqué à la création du compte admin seulement (_MP_PASSWORD_MINLENGTH=0 dans compose.yaml).
OIE_PASSWORD=admin

# Base et keystore : à fixer avant le premier démarrage.
POSTGRES_PASSWORD=demo-fhir-mapper-db
OIE_KEYSTORE_STOREPASS=demo-fhir-mapper-store
OIE_KEYSTORE_KEYPASS=demo-fhir-mapper-key
OIE_SERVER_ID=18a8d2ca-8afb-4fd3-a7a6-7123d38aa468

# Évite l'assistant de changement du mot de passe à la première connexion.
OIE_SKIP_FIRST_LOGIN=true

# Options du build officiel d'OIE.
OIE_GRADLE_BUILD_ARGS=-PdisableSigning=true
