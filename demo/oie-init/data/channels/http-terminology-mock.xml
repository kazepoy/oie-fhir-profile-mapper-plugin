          <script>var uri = String(sourceMap.get('uri') || sourceMap.get('url') || '');
var query = String(sourceMap.get('query') || '');
var params = sourceMap.get('parameters');
function param(name) {
    if (params &amp;&amp; typeof params.getParameter === 'function') {
        var v = params.getParameter(name);
        if (v !== null &amp;&amp; v !== undefined &amp;&amp; String(v) !== '') return String(v);
    }
    var m = new RegExp('(?:^|&amp;)' + name + '=([^&amp;]*)').exec(query);
    return m ? decodeURIComponent(m[1].replace(/\+/g, ' ')) : '';
}
var code = param('code') || param('sourceCode');
if (code === 'UNAVAILABLE' || param('fail') === '503') {
    channelMap.put('httpStatus', '503');
    msg = JSON.stringify({
        resourceType: 'OperationOutcome',
        issue: [{ severity: 'error', code: 'transient', diagnostics: 'Mock terminology server unavailable (503)' }]
    });
} else if (uri.indexOf('$translate') &gt;= 0 || code !== '') {
    channelMap.put('httpStatus', '200');
    if (code === 'GLU') {
        msg = JSON.stringify({
            resourceType: 'Parameters',
            parameter: [
                { name: 'result', valueBoolean: true },
                {
                    name: 'match',
                    part: [
                        { name: 'equivalence', valueCode: 'equivalent' },
                        { name: 'concept', valueCoding: { system: 'http://loinc.org', code: '14749-6', display: 'Glucose [Moles/volume] in Serum or Plasma' } }
                    ]
                }
            ]
        });
    } else {
        msg = JSON.stringify({
            resourceType: 'Parameters',
            parameter: [{ name: 'result', valueBoolean: false }]
        });
    }
} else {
    channelMap.put('httpStatus', '200');
    msg = JSON.stringify({ resourceType: 'Bundle', type: 'searchset', total: 0, entry: [] });
}</script>
