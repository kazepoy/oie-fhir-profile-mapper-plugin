            <fhirVersion>R4</fhirVersion>
            <profiles />
            <context>demo-labo</context>
            <mapUrl />
            <mapSource>map "http://example.org/fhir/oru2fhir/StructureMap/OruR01StrictToPatient" = "OruR01StrictToPatient"

uses "http://oie.org/fhir/StructureDefinition/OieMessage" alias OieMessage as source
uses "http://example.org/fhir/oru2fhir/StructureDefinition/ExampleLabPatient" alias Patient as target

group OruR01StrictToPatient(source src : OieMessage, target patient : Patient) {
  src -&gt; patient.meta as meta, meta.profile = 'http://example.org/fhir/oru2fhir/StructureDefinition/ExampleLabPatient' "profile";
  src.node as pr where name = 'ORU_R01.PATIENT_RESULT' then {
    pr.node as pg where name = 'ORU_R01.PATIENT' then {
      pg.node as pid where name = 'PID' then {
        pid.node as cx where name = 'PID.3' and node.where(name = 'CX.5' and value = 'PI').exists() then {
          cx.node as number where name = 'CX.1' -&gt; patient.identifier as identifier then {
            number -&gt; identifier.system = 'http://example.org/fhir/oru2fhir/sid/ipp' "ipp-system";
            number.value as v -&gt; identifier.value = v "ipp-value";
          } "ipp";
        } "identifiers";
        pid.node as xpn where name = 'PID.5' -&gt; patient.name as name then {
          xpn.node as family where name = 'XPN.1' then {
            family.node as fn where name = 'FN.1' then { fn.value as v -&gt; name.family = v "family"; } "fn";
          } "family-name";
          xpn.node as given where name = 'XPN.2' then { given.value as v -&gt; name.given = v "given"; } "given-name";
          xpn.node as second where name = 'XPN.3' then { second.value as v -&gt; name.given = v "second-given"; } "second-given-name";
          xpn.node as type where name = 'XPN.7' and value = 'L' -&gt; name.use = 'official' "use-official";
          xpn.node as type where name = 'XPN.7' and value = 'D' -&gt; name.use = 'usual' "use-usual";
          xpn.node as type where name = 'XPN.7' and value = 'M' -&gt; name.use = 'maiden' "use-maiden";
        } "name";
        pid.node as sex where name = 'PID.8' then {
          sex.value as v -&gt; patient.gender = translate(v, 'http://example.org/fhir/oru2fhir/ConceptMap/v2-0001-to-gender', 'code') "gender";
        } "sex";
        pid.node as dob where name = 'PID.7' then {
          dob.node as ts where name = 'TS.1' then {
            ts.value as v where v.length() &gt;= 8 -&gt; patient.birthDate = (v.substring(0, 4) &amp; '-' &amp; v.substring(4, 2) &amp; '-' &amp; v.substring(6, 2)) "birthDate";
          } "birth-time";
        } "date-of-birth";
      } "pid";
    } "patient-group";
  } "patient-result";
}
</mapSource>
