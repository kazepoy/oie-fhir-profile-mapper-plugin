            <mapUrl />
            <mapSource>map "http://example.org/fhir/oru2fhir/StructureMap/SqlXmlToPatient" = "SqlXmlToPatient"

uses "http://oie.org/fhir/StructureDefinition/OieMessage" alias OieMessage as source
uses "http://example.org/fhir/oru2fhir/StructureDefinition/ExampleLabPatient" alias Patient as target

group SqlXmlToPatient(source src : OieMessage, target patient : Patient) {
  src -&gt; patient.meta as meta, meta.profile = 'http://example.org/fhir/oru2fhir/StructureDefinition/ExampleLabPatient' "profile";
  src where name = 'result' then {
    src.node as id where name = 'id_patient' then { id.value as v -&gt; patient.id = ('metier-' &amp; v) "id"; } "id-node";
    src.node as act where name = 'actif' and value = '1' -&gt; patient.active = true "active-true";
    src.node as act where name = 'actif' and value = '0' -&gt; patient.active = false "active-false";
    src.node as ipp where name = 'ipp' -&gt; patient.identifier as identifier then {
      ipp -&gt; identifier.system = 'http://example.org/fhir/oru2fhir/sid/ipp' "ipp-system";
      ipp.value as v -&gt; identifier.value = v "ipp-value";
    } "identifier";
    src -&gt; patient.name as name, name.use = 'official' then {
      src.node as nom where name = 'nom_naissance' then { nom.value as v -&gt; name.family = v "family"; } "family-node";
      src.node as pre where name = 'prenom' then { pre.value as v -&gt; name.given = v "given"; } "given-node";
    } "name";
    src.node as sex where name = 'sexe' then {
      sex.value as v -&gt; patient.gender = translate(v, 'http://example.org/fhir/oru2fhir/ConceptMap/v2-0001-to-gender', 'code') "gender";
    } "sex-node";
    src.node as dob where name = 'date_naissance' then { dob.value as v -&gt; patient.birthDate = v "birthDate"; } "dob-node";
  } "result";
}
</mapSource>
