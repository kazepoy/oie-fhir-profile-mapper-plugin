    }).join(',') + '}';
}

var out1 = cm1 &amp;&amp; cm1.getEncoded() ? String(cm1.getEncoded().getContent()) : '';
var out2 = cm2 &amp;&amp; cm2.getEncoded() ? String(cm2.getEncoded().getContent()) : '';
