          <script>// Native batch isolated one row and Delimited Text parsed it into XML.
// Business cleanup only; FHIR construction belongs in the destination.
channelMap.put('__demoEtape', 'SOURCE_CLEANUP');
var row = msg['row'][0];
for each (var field in row.children()) {
    row[field.name().toString()] = field.toString().trim();
}
row['sexe'] = row['sexe'].toString().toUpperCase();
var birthDate = row['date_naissance'].toString();
if (birthDate !== '') {
    try {
        if (!/^\d{8}$/.test(birthDate)) throw new Error('expected format: YYYYMMDD');
        row['date_naissance'] = String(java.time.LocalDate.parse(birthDate, java.time.format.DateTimeFormatter.BASIC_ISO_DATE));
    } catch (e) {
        throw new Error('Business patient ' + row['id_patient'] + ', invalid birth date: "' + birthDate + '" (expected: YYYYMMDD, valid date).');
    }
}</script>
