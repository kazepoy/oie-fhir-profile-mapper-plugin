  <postprocessingScript>// Compare both destination outputs and store execution timings in metadata.
var cm1 = message.getConnectorMessages().get(java.lang.Integer.valueOf(1));
var cm2 = message.getConnectorMessages().get(java.lang.Integer.valueOf(2));
var fmlMs = cm1 != null ? cm1.getChannelMap().get('FML_MS') : null;
var mapperMs = cm2 != null ? cm2.getChannelMap().get('MAPPER_MS') : null;

function canonical(value) {
    if (value === null || typeof value !== 'object') return JSON.stringify(value);
    if (Array.isArray(value)) return '[' + value.map(canonical).join(',') + ']';
    return '{' + Object.keys(value).sort().map(function (k) {
        return JSON.stringify(k) + ':' + canonical(value[k]);
    }).join(',') + '}';
}

var out1 = cm1 &amp;&amp; cm1.getEncoded() ? String(cm1.getEncoded().getContent()) : '';
var out2 = cm2 &amp;&amp; cm2.getEncoded() ? String(cm2.getEncoded().getContent()) : '';
var outputsEqual = 'false';
if (out1 &amp;&amp; out2) {
    try {
        outputsEqual = canonical(JSON.parse(out1)) === canonical(JSON.parse(out2)) ? 'true' : 'false';
    } catch (e) {
        outputsEqual = out1.trim() === out2.trim() ? 'true' : 'false';
    }
}

var errorLabel = 'OK';
var connectors = message.getConnectorMessages().values().iterator();
while (connectors.hasNext()) {
    var cm = connectors.next();
    var error = cm.getProcessingError() || cm.getResponseError() || cm.getPostProcessorError();
    if (error) {
        var details = String(error);
        var cause = /DETAILS:\s*([^\r\n]+)/.exec(details);
        errorLabel = (cm.getConnectorName() + ': ' + (cause ? cause[1] : details.split(/\r?\n/)[0])).substring(0, 255);
        break;
    }
}

var values = new java.util.HashMap();
if (fmlMs != null) values.put('FML_MS', new java.math.BigDecimal(String(fmlMs)));
if (mapperMs != null) values.put('MAPPER_MS', new java.math.BigDecimal(String(mapperMs)));
if (fmlMs != null &amp;&amp; mapperMs != null) {
    var diffMs = Math.round((Number(fmlMs) - Number(mapperMs)) * 1000) / 1000;
    values.put('DIFF_MS', new java.math.BigDecimal(String(diffMs)));
}
values.put('OUTPUTS_EQUAL', outputsEqual);
values.put('ERROR_STEP', errorLabel);
var record = new Packages.com.mirth.connect.donkey.model.message.ConnectorMessage();
record.setChannelId(channelId);
record.setMessageId(message.getMessageId());
record.setMetaDataId(0);
record.setMetaDataMap(values);
var dao = Packages.com.mirth.connect.donkey.server.Donkey.getInstance().getDaoFactory().getDao();
var committed = false;
try {
    dao.storeMetaData(record, dao.getMetaDataColumns(channelId));
    dao.commit();
    committed = true;
} finally {
    try {
        if (!committed) dao.rollback();
    } finally {
        dao.close();
    }
}
return;</postprocessingScript>
