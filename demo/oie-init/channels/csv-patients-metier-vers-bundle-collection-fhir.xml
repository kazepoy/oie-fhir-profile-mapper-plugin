          <enabled>true</enabled>
          <script>// Le CSV complet est parsé en XML ; chaque ligne métier sera nettoyée.
// Nettoyage métier uniquement ; la construction FHIR appartient à la destination.
channelMap.put('__demoEtape', 'NETTOYAGE_SOURCE');
// Sans batch, l'en-tête est une première ligne parsée par le type Delimited Text.
if (msg['row'][0]['id_patient'].toString() !== 'id_patient') {
    throw new Error('En-tête CSV attendu : id_patient;ipp;nom_naissance;prenom;date_naissance;sexe;actif');
}
delete msg['row'][0];
for each (var row in msg['row']) {
    for each (var field in row.children()) {
        row[field.name().toString()] = field.toString().trim();
    }
    row['sexe'] = row['sexe'].toString().toUpperCase();
    var birthDate = row['date_naissance'].toString();
    if (birthDate !== '') {
        try {
            if (!/^\d{8}$/.test(birthDate)) throw new Error('format attendu : AAAAMMJJ');
            row['date_naissance'] = String(java.time.LocalDate.parse(birthDate, java.time.format.DateTimeFormatter.BASIC_ISO_DATE));
        } catch (e) {
            throw new Error('Patient métier ' + row['id_patient'] + ', date_naissance invalide : "' + birthDate + '" (attendu : AAAAMMJJ, date réelle).');
        }
    }
}</script>
        </com.mirth.connect.plugins.javascriptstep.JavaScriptStep>
