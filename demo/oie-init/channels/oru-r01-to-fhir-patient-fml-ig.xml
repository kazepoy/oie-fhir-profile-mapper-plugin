  <preprocessingScript>// Reset for every message, including after reprocessing.
channelMap.put('TOTAL_MS', 0);
channelMap.remove('TRANSFO_MS');
channelMap.put('ERROR_STEP', 'OK');
channelMap.put('__demoEtape', 'READ_HL7');
channelMap.remove('__fhirMapperPhase');
channelMap.remove('__fhirMapperBuildFinishedNano');
channelMap.remove('__fhirMapperValidationNanos');
return message;</preprocessingScript>
  <postprocessingScript>// Runs after destinations, including after a read/transformation/validation error.
var source = message.getConnectorMessages().get(java.lang.Integer.valueOf(0));
var total = Math.max(0, java.lang.System.currentTimeMillis() - source.getReceivedDate().getTimeInMillis());
var errorLabel = 'OK';
var connectors = message.getConnectorMessages().values().iterator();
while (connectors.hasNext()) {
    var cm = connectors.next();
    var error = cm.getProcessingError() || cm.getResponseError() || cm.getPostProcessorError();
    if (error) {
        var stage = cm.getMetaDataId() == 0
            ? String(source.getChannelMap().get('__fhirMapperPhase') == 'VALIDATION' ? 'OUTBOUND_FHIR_VALIDATION' : (source.getChannelMap().get('__demoEtape') || 'READ_HL7'))
            : 'OUTPUT / ' + cm.getConnectorName();
        var details = String(error);
        var issue = /(?:^|\n)(?:error|fatal)\s+@?\s*([^\r\n]+)/i.exec(details);
        var cause = /DETAILS:\s*([^\r\n]+)/.exec(details);
        details = cause ? cause[1] : issue ? issue[1] : details.split(/\r?\n/)[0];
        errorLabel = (stage + ': ' + details).substring(0, 255);
        break;
    }
}

// OIE stores metadata before the postprocessor: update the source row
// via its DAO to keep total time and outbound errors.
var values = new java.util.HashMap();
values.put('TOTAL_MS', new java.math.BigDecimal(String(total)));
var transfo = source.getChannelMap().get('TRANSFO_MS');
var finished = source.getChannelMap().get('__fhirMapperBuildFinishedNano');
if (transfo == null &amp;&amp; finished != null) {
    transfo = Math.round((Number(finished) - Number(source.getChannelMap().get('__demoTransfoDebut'))) / 1000) / 1000;
}
if (transfo != null) {
    values.put('TRANSFO_MS', new java.math.BigDecimal(String(transfo)));
}
values.put('ERROR_STEP', errorLabel);
var record = new Packages.com.mirth.connect.donkey.model.message.ConnectorMessage();
record.setChannelId(channelId);
record.setMessageId(message.getMessageId());
record.setMetaDataId(0);
record.setMetaDataMap(values);
var dao = Packages.com.mirth.connect.donkey.server.Donkey.getInstance().getDaoFactory().getDao();
var committed = false;
try {
    dao.storeMetaData(record, dao.getMetaDataColumns(channelId));
    dao.commit();
    committed = true;
} finally {
    try {
        if (!committed) dao.rollback();
    } finally {
        dao.close();
    }
}
return;</postprocessingScript>
