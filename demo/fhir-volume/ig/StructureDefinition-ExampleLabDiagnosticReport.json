{
  "resourceType": "StructureDefinition",
  "id": "ExampleLabDiagnosticReport",
  "url": "http://example.org/fhir/oru2fhir/StructureDefinition/ExampleLabDiagnosticReport",
  "version": "0.1.0",
  "name": "ExampleLabDiagnosticReport",
  "title": "Compte rendu de laboratoire",
  "status": "draft",
  "experimental": true,
  "publisher": "Exemple oru2fhir",
  "description": "Le compte rendu d'une demande (OBR) : catégorie LAB, examen, patient, résultats et document PDF éventuel.",
  "fhirVersion": "4.0.1",
  "kind": "resource",
  "abstract": false,
  "type": "DiagnosticReport",
  "baseDefinition": "http://hl7.org/fhir/StructureDefinition/DiagnosticReport",
  "derivation": "constraint",
  "differential": {
    "element": [
      {
        "id": "DiagnosticReport",
        "path": "DiagnosticReport"
      },
      {
        "id": "DiagnosticReport.category",
        "path": "DiagnosticReport.category",
        "min": 1,
        "slicing": {
          "discriminator": [
            {
              "type": "pattern",
              "path": "$this"
            }
          ],
          "rules": "open"
        }
      },
      {
        "id": "DiagnosticReport.category:lab",
        "path": "DiagnosticReport.category",
        "sliceName": "lab",
        "min": 1,
        "max": "1",
        "patternCodeableConcept": {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/v2-0074",
              "code": "LAB"
            }
          ]
        }
      },
      {
        "id": "DiagnosticReport.subject",
        "path": "DiagnosticReport.subject",
        "min": 1,
        "mustSupport": true
      },
      {
        "id": "DiagnosticReport.effective[x]",
        "path": "DiagnosticReport.effective[x]",
        "min": 1,
        "type": [
          {
            "code": "dateTime"
          }
        ]
      },
      {
        "id": "DiagnosticReport.result",
        "path": "DiagnosticReport.result",
        "mustSupport": true
      },
      {
        "id": "DiagnosticReport.presentedForm",
        "path": "DiagnosticReport.presentedForm",
        "mustSupport": true
      }
    ]
  }
}